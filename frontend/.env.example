# Optional. By default the app calls /api/student-service, which the Vite dev/preview server
# proxies to the Student Service (avoids CORS, because the backend has no CORS configuration).
# VITE_STUDENT_SERVICE_URL=http://localhost:8081   # proxy target
# VITE_STUDENT_API_URL=http://localhost:8081       # call the service directly (needs CORS on the backend)
